PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/faith-forever

# Frontend origins allowed to call this API (comma-separated).
# Localhost is always allowed. Add your live site the same way you set VITE_API_URL.
# Example: http://localhost:8080,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Secret key for /studio (send as x-admin-key). Pick something long and private.
ADMIN_KEY=change-me-to-a-long-secret

# Extra salt for hashing Faith's love-letter unlock password
LETTER_PEPPER=another-private-string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
